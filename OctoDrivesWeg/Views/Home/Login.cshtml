            </ul>
        </li>
            <li>
                <a href="/Bookings/Index">Bookings</a>
            </li>
    </ul>
</nav>

<div class="container">

    <div class="banner-box">
        <a href="/Home/About">
            <img src="/images/login-banner.jpeg" alt="OctoDrives login banner - go to About Us" width="900" height="200" class="banner">
            <span class="banner-text">Welcome To OctoDrives</span>
        </a>
    </div>

    <h2 style="text-align:center;">Welcome Back</h2>
    <p style="text-align:center;">Log in to manage your test-drive bookings.</p>

    <form name="loginForm" method="post" action="index.html">
        <p>
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" class="field" placeholder="name@domain.com">
        </p>
        <p>
            <label for="pwd">Password</label>
            <input type="password" id="pwd" name="pwd" class="field" placeholder="Enter your password">
        </p>
        <p>
            <input type="checkbox" id="remember" name="remember" checked>
            <label for="remember" style="display:inline;">Remember me</label>
        </p>
        <p>
            <input type="button" value="Login" class="btn" onclick="validateLogin()">
            <input type="reset" value="Clear" class="btn gray">
        </p>
        <p style="text-align:center;">
            Don't have an account? <a href="/Home/Signup">Sign Up here</a>
        </p>
    </form>

</div>

<footer>
    <p>&copy; 2026 OctoDrives. All Rights Reserved.</p>
